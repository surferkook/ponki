# Copy to .env and fill in. Never commit .env.
#
# The one thing you must set: a Meta Model API key (souls think with Muse
# Spark, the builder with Muse Wonder, finding is SAM 3.1).
META_API_KEY=
# Your first name: the robots will call you by it.
HOUSE_HUMAN=
# Every body and workshop presents this token to the hub. Make it long and
# random once anything outside this machine connects.
HOUSE_TOKEN=change-me-to-a-long-random-string
# Where workshops and bodies on other machines find the hub (not needed
# with Docker: compose wires its own workshop to the hub).
HOUSE_HUB=ws://192.0.2.7:8200
# Your time zone, so robots know if it's morning (Docker), e.g. Europe/Paris
TZ=
HOUSE_MODEL=muse-spark-1.3
HOUSE_EFFORT=low
HOUSE_BUILDER_MODEL=muse-wonder-1.0
HOUSE_BUILDER_EFFORT=medium
HOUSE_SEARCH_MODEL=muse-spark-1.3-contributor
HOUSE_SEARCH_EFFORT=minimal
# Roughly where the house is (country,city,timezone), to bias web searches,
# e.g. US,Chicago,America/Chicago
HOUSE_LOCATION=
META_API_BASE=https://api.meta.ai/v1
HOUSE_VOICE_URL=http://127.0.0.1:8202
HOUSE_EARS_URL=http://127.0.0.1:8203
# Ears (services/ears): EARS_ENGINE=auto|muse|whisper, model, language
EARS_ENGINE=auto
EARS_MODEL=small
EARS_LANGUAGE=en
# Speaker/mic on a workshop machine (Pi)
SPEAKER_DEVICE=house
SPEAKER_LEADIN=1.0
SPEAKER_KEEPAWAKE=240
SPEAKER_MAC=AA:BB:CC:DD:EE:FF
SPEAKER_VOLUME=70%
MIC_SOURCE=alsa:Edition
MIC_LATENCY=0.1
HOUSE_SAM_URL=http://127.0.0.1:8201
HOUSE_SAM_ENDPOINT=https://api.meta.ai/v1/responses
HOUSE_SAM_MODEL=sam-3.1
HOUSE_EYE_AWAKE=60
# Standing in: a networked robot (the camera) whose workshop has gone moves to
# another workshop that reaches it, after this many seconds. off turns it off.
HOUSE_TAKEOVER=on
HOUSE_TAKEOVER_AFTER=60
# Photos kept per robot (oldest go first)
HOUSE_SEEN_KEEP=200
# Events the hub holds in memory and the UI shows (the file keeps them all)
HOUSE_EVENTS_KEEP=1000
