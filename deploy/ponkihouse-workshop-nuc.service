[Unit]
Description=Ponkihouse workshop (NUC) — finds devices and runs robots (RoBoHoN, and stands in for cameras)
After=network.target

[Service]
Type=simple
User=@PONKI_USER@
WorkingDirectory=@PONKI_DIR@
ExecStart=@PONKI_DIR@/.venv/bin/python -u bodies/workshop/workshop.py
Restart=on-failure
RestartSec=2
EnvironmentFile=@PONKI_DIR@/.env
Environment=HOUSE_WORKSHOP_FAMILIES=robohon,onvif

[Install]
WantedBy=multi-user.target
