[Unit]
Description=Ponkihouse mic — the house microphone on this machine
After=network.target sound.target

[Service]
Type=simple
User=@PONKI_USER@
WorkingDirectory=@PONKI_DIR@
ExecStart=@PONKI_DIR@/.venv/bin/python -u bodies/mic/mic_fixture.py
Restart=on-failure
RestartSec=2
EnvironmentFile=@PONKI_DIR@/.env

[Install]
WantedBy=multi-user.target

# Until the workshop (spec 09) runs the mic as a family driver, this unit
# runs it directly on the Pi.
