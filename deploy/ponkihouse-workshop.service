[Unit]
Description=Ponkihouse workshop — finds devices and runs robots (all families)
After=network.target

[Service]
Type=simple
User=@PONKI_USER@
WorkingDirectory=@PONKI_DIR@
ExecStart=@PONKI_DIR@/.venv/bin/python -u bodies/workshop/workshop.py
Restart=on-failure
RestartSec=2
EnvironmentFile=@PONKI_DIR@/.env

[Install]
WantedBy=multi-user.target
