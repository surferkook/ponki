[Unit]
Description=Ponkihouse hub — the house itself (souls, the record, the web UI)
After=network.target tailscaled.service
Wants=tailscaled.service

[Service]
Type=simple
User=@PONKI_USER@
WorkingDirectory=@PONKI_DIR@
ExecStart=@PONKI_DIR@/.venv/bin/uvicorn hub.main:app --host 0.0.0.0 --port 8200
Restart=on-failure
RestartSec=2
EnvironmentFile=@PONKI_DIR@/.env

[Install]
WantedBy=multi-user.target
